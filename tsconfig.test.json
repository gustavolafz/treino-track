{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".tmp-test",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "lib/utils.ts",
    "lib/dateCache.ts",
    "lib/schedule.ts",
    "lib/seedData.ts",
    "lib/__tests__/*.ts",
    "lib/__tests__/*.d.ts",
    "modules/treino-native/index.web.ts",
    "types/**/*.ts"
  ]
}
